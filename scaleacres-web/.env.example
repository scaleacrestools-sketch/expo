# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://scaleacres.com

# Contact form delivery (server-side only). The form refuses to report success
# unless the message was actually delivered.
# Option A: Resend (https://resend.com) — HTTP API, no SDK required.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ScaleAcres Website <website@scaleacres.com>
CONTACT_TO_EMAIL=scaleacres@gmail.com

# Option B: any webhook that accepts a JSON POST (Zapier, Make, Pabbly, n8n, Google Apps Script).
# If both are set, both are attempted; success requires at least one to accept the message.
CONTACT_WEBHOOK_URL=

# Analytics (optional). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Comma-separated hostnames allowed to be indexed. Every other host is noindex.
PRODUCTION_HOSTS=scaleacres.com,www.scaleacres.com

# Origin hostname that keeps serving the current WordPress site (e.g. https://wp.scaleacres.com).
# When set, every protected page marked serveFrom:"wordpress" in content/seo/pages.ts and
# every path this app does not implement is proxied unchanged from WordPress.
# Leave EMPTY on staging so the redesigned pages render for review.
WORDPRESS_ORIGIN=
