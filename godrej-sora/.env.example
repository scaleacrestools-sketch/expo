# ---- Godrej Sora landing page: runtime configuration ----
# Copy to .env.local. Leave values empty to disable an integration; nothing is faked.

# Public site URL (used for canonical / OpenGraph)
NEXT_PUBLIC_SITE_URL=

# Advertiser identity (channel-partner disclosure). Leave ADVERTISER_IS_DEVELOPER empty unless this is Godrej Properties' own site.
NEXT_PUBLIC_ADVERTISER_NAME=
NEXT_PUBLIC_ADVERTISER_RERA=
NEXT_PUBLIC_ADVERTISER_IS_DEVELOPER=

# Sales contact (shown on the page and used by Call / WhatsApp CTAs). E.164 without "+", e.g. 91XXXXXXXXXX
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SALES_EMAIL=

# Analytics (rendered only when set)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Lead delivery (server-side). Any combination may be set.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads
LEAD_NOTIFY_EMAIL=
RESEND_API_KEY=

# Local fallback store (NDJSON file) used when no CRM target is configured. Default: .data/leads.ndjson
LEADS_FILE_PATH=

# Spam controls
LEAD_RATE_LIMIT_PER_10MIN=5
LEAD_DUPLICATE_WINDOW_HOURS=24
