{
  "name": "real-estate-ai-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "media:video": "node scripts/render-video/narration.mjs && node scripts/render-video/render.mjs",
    "media:gifs": "node scripts/generate-gifs/generate.mjs",
    "media:screenshots": "node scripts/capture-screenshots/capture.mjs",
    "media:audio": "node scripts/generate-audio/build-audio.mjs",
    "media:record": "node scripts/record-preview/record.mjs desktop && node scripts/record-preview/record.mjs mobile",
    "media:responsive": "node scripts/capture-screenshots/responsive.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
