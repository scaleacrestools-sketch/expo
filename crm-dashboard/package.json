{
  "name": "crm-pipeline-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sales & Customer Pipeline CRM Dashboard \u2014 AI-assisted practice prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "export:svg": "node scripts/export-svg.mjs",
    "export:previews": "node scripts/render-svg-previews.mjs",
    "export:all": "npm run build && (npx vite preview --port 4173 --strictPort & echo $! > .preview.pid; sleep 2; npm run verify:responsive && npm run export:svg && npm run export:previews; kill $(cat .preview.pid); rm .preview.pid)"
  },
  "dependencies": {
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12"
  }
}
